# src/chain/blockchain.py
import hashlib
import json
import time
from datetime import datetime
from typing import List, Dict, Any

class SCOSBlock:
    def __init__(self, index: int, timestamp: str, claim: str, 
                 votes: Dict, consensus: float, submitter: str,
                 previous_hash: str, nonce: int = 0):
        self.index = index
        self.timestamp = timestamp
        self.claim = claim
        self.votes = votes
        self.consensus = consensus
        self.submitter = submitter
        self.previous_hash = previous_hash
        self.nonce = nonce
        self.hash = self.calculate_hash()
    
    def calculate_hash(self) -> str:
        """Calculate block hash using SHA-256"""
        block_string = json.dumps({
            'index': self.index,
            'timestamp': self.timestamp,
            'claim': self.claim,
            'votes': self.votes,
            'consensus': self.consensus,
            'submitter': self.submitter,
            'previous_hash': self.previous_hash,
            'nonce': self.nonce
        }, sort_keys=True)
        return hashlib.sha256(block_string.encode()).hexdigest()
    
    def mine_block(self, difficulty: int = 4):
        """Proof of work mining"""
        target = '0' * difficulty
        while self.hash[:difficulty] != target:
            self.nonce += 1
            self.hash = self.calculate_hash()
        print(f"Block {self.index} mined: {self.hash}")

class SCOSBlockchain:
    def __init__(self):
        self.chain: List[SCOSBlock] = []
        self.difficulty = 4
        self.create_genesis_block()
    
    def create_genesis_block(self):
        """Create the genesis block from ToKB"""
        genesis_data = {
            'claim': 'The process is the point. Navigate accordingly.',
            'votes': {f'W{i+1}': 1.0 for i in range(7)},
            'consensus': 1.0,
            'submitter': 'Del1r1ous'
        }
        genesis_block = SCOSBlock(
            index=0,
            timestamp=str(datetime.now()),
            **genesis_data,
            previous_hash='0'
        )
        genesis_block.mine_block(self.difficulty)
        self.chain.append(genesis_block)
    
    def get_latest_block(self) -> SCOSBlock:
        return self.chain[-1]
    
    def add_block(self, block: SCOSBlock):
        block.previous_hash = self.get_latest_block().hash
        block.index = len(self.chain)
        block.mine_block(self.difficulty)
        self.chain.append(block)
    
    def is_valid(self) -> bool:
        for i in range(1, len(self.chain)):
            current = self.chain[i]
            previous = self.chain[i-1]
            
            if current.hash != current.calculate_hash():
                return False
            if current.previous_hash != previous.hash:
                return False
        return True
