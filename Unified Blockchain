# src/chain/consensus.py
import threading
import queue
from typing import Dict, Any
from datetime import datetime

class ConsensusEngine:
    def __init__(self, blockchain, witness_network, threshold=0.95):
        self.blockchain = blockchain
        self.witnesses = witness_network
        self.threshold = threshold
        self.queue = queue.Queue()
        self.is_running = False
        self.thread = None
        self.pending_claims = []
        self.verified_blocks = []
        
    def start(self):
        """Start the consensus engine"""
        if not self.is_running:
            self.is_running = True
            self.thread = threading.Thread(target=self._process_claims)
            self.thread.start()
            print("⚡ Consensus Engine Started")
    
    def stop(self):
        """Stop the consensus engine"""
        self.is_running = False
        if self.thread:
            self.thread.join()
            print("🛑 Consensus Engine Stopped")
    
    def submit_claim(self, claim: str, submitter: str):
        """Submit a claim to the consensus queue"""
        self.queue.put({
            'claim': claim,
            'submitter': submitter,
            'timestamp': datetime.now().isoformat()
        })
        print(f"📝 Claim submitted by {submitter}")
    
    def _process_claims(self):
        """Process claims in the queue"""
        while self.is_running:
            try:
                data = self.queue.get(timeout=1)
                claim = data['claim']
                submitter = data['submitter']
                
                print(f"🔍 Processing claim: {claim[:50]}...")
                
                # Poll all witnesses
                result = self.witnesses.poll_all(claim)
                votes = result['votes']
                
                # Calculate consensus
                consensus = self.witnesses.calculate_consensus(votes)
                
                # Create block if threshold met
                if consensus >= self.threshold:
                    block = SCOSBlock(
                        index=len(self.blockchain.chain),
                        timestamp=datetime.now().isoformat(),
                        claim=claim,
                        votes=votes,
                        consensus=consensus,
                        submitter=submitter,
                        previous_hash=self.blockchain.get_latest_block().hash
                    )
                    
                    self.blockchain.add_block(block)
                    self.verified_blocks.append(block)
                    
                    print(f"✅ Block {block.index} verified with consensus {consensus:.2f}")
                    print(f"🔗 Hash: {block.hash}")
                    
                    # Notify community
                    self._notify_community(block)
                else:
                    print(f"❌ Consensus failed: {consensus:.2f} (threshold: {self.threshold})")
                    self.pending_claims.append(data)
                
                self.queue.task_done()
                
            except queue.Empty:
                continue
            except Exception as e:
                print(f"⚠️ Error processing claim: {e}")
                continue
    
    def _notify_community(self, block: SCOSBlock):
        """Notify community of new verified block"""
        # WebSocket broadcast
        # Email notifications
        # Social media posts
        pass
    
    def get_status(self) -> Dict[str, Any]:
        """Get engine status"""
        return {
            'is_running': self.is_running,
            'queue_size': self.queue.qsize(),
            'verified_blocks': len(self.verified_blocks),
            'pending_claims': len(self.pending_claims),
            'chain_length': len(self.blockchain.chain)
        }
