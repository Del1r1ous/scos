        avg = sum(values) / len(values)
        
        # Check for unanimous consensus (all votes >= 0.95)
        if all(v >= 0.95 for v in values):
            return 1.0
        
        # Check for near-unanimous consensus
        if all(v >= 0.90 for v in values):
            return 0.95
            
        return avg
