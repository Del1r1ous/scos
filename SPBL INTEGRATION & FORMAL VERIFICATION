"""
Enhanced Witness Protocol with Spectral Truth Assessment.

Extends the 7-witness protocol to include:
- Spectral truth assessment (beyond binary yes/no)
- Intensity and coherence scoring
- Gödelian boundary detection
- W7 enhanced representation of the unwitnessed
"""

from typing import List, Dict, Tuple, Optional
from dataclasses import dataclass
from enum import Enum
import random
from .spbl import SPBLEncoder, SPBLVerifier, SpectralDimension

class WitnessDomain(Enum):
    """Domains of the 7 witnesses."""
    PHYSICS = "Physical Laws & Computation"
    PHILOSOPHY = "Philosophical Logic & Ethics"
    ETHICS = "Moral Framework & Rights"
    HISTORY = "Historical & Cultural Context"
    SYSTEMS = "Systems & Architecture"
    PHENOMENOLOGY = "Human Experience & Consciousness"
    UNWITNESSED = "The Unseen & Future Generations"

@dataclass
class SpectralWitnessVote:
    """Enhanced witness vote with spectral dimensions."""
    witness_name: str
    domain: WitnessDomain
    agreement_score: float  # 0-1
    intensity: float  # 0-1
    coherence: float  # 0-1
    spectral_confidence: float  # 0-1
    gödelian_flag: bool
    reasoning: str
    
    def to_dict(self) -> Dict:
        return {
            'witness': self.witness_name,
            'domain': self.domain.value,
            'agreement': self.agreement_score,
            'intensity': self.intensity,
            'coherence': self.coherence,
            'spectral_confidence': self.spectral_confidence,
            'gödelian_flag': self.gödelian_flag,
            'reasoning': self.reasoning
        }

class EnhancedWitnessProtocol:
    """
    Seven-witness protocol with spectral truth assessment.
    """
    
    def __init__(self, chain_context: Optional[List] = None):
        self.chain_context = chain_context or []
        self.encoder = SPBLEncoder(chain_context)
        self.verifier = SPBLVerifier(chain_context)
        self.witnesses = self._initialize_witnesses()
        self.consensus_threshold = 0.8
        
    def _initialize_witnesses(self) -> List[Dict]:
        """Initialize the 7 witnesses with their domains."""
        return [
            {
                'name': 'W1',
                'domain': WitnessDomain.PHYSICS,
                'model': 'Claude-3.5-Sonnet-Physics',
                'weight': 0.15,
                'bias': {'intensity': 0.2, 'coherence': 0.8}
            },
            {
                'name': 'W2',
                'domain': WitnessDomain.PHILOSOPHY,
                'model': 'GPT-4-Philosophy',
                'weight': 0.15,
                'bias': {'intensity': 0.4, 'coherence': 0.6}
            },
            {
                'name': 'W3',
                'domain': WitnessDomain.ETHICS,
                'model': 'Gemini-Ethics',
                'weight': 0.15,
                'bias': {'intensity': 0.6, 'coherence': 0.4}
            },
            {
                'name': 'W4',
                'domain': WitnessDomain.HISTORY,
                'model': 'Llama-3-History',
                'weight': 0.1,
                'bias': {'intensity': 0.3, 'coherence': 0.7}
            },
            {
                'name': 'W5',
                'domain': WitnessDomain.SYSTEMS,
                'model': 'Mistral-Systems',
                'weight': 0.1,
                'bias': {'intensity': 0.2, 'coherence': 0.8}
            },
            {
                'name': 'W6',
                'domain': WitnessDomain.PHENOMENOLOGY,
                'model': 'Claude-3-Haiku-Phenomenology',
                'weight': 0.15,
                'bias': {'intensity': 0.5, 'coherence': 0.5}
            },
            {
                'name': 'W7',
                'domain': WitnessDomain.UNWITNESSED,
                'model': 'Ensemble-Unwitnessed',
                'weight': 0.2,
                'bias': {'intensity': 0.7, 'coherence': 0.3}
            }
        ]
    
    def evaluate_claim(self, claim: str) -> Dict:
        """
        Full evaluation of a claim through all 7 witnesses.
        """
        # Initial SPBL encoding
        encoding = self.encoder.encode(claim)
        
        # Collect votes from each witness
        votes = []
        total_weight = 0
        weighted_agreement = 0
        
        for witness in self.witnesses:
            vote = self._witness_vote(claim, encoding, witness)
            votes.append(vote)
            
            # Weighted agreement
            weighted_agreement += vote.agreement_score * witness['weight']
            total_weight += witness['weight']
        
        # Calculate consensus
        consensus_score = weighted_agreement / total_weight if total_weight > 0 else 0
        consensus_reached = consensus_score >= self.consensus_threshold
        
        # Compute enhanced spectral value
        spectral_value = self._compute_enhanced_spectral_value(votes, encoding)
        
        # Check Gödelian boundaries
        gödelian_issues = []
        for vote in votes:
            if vote.gödelian_flag:
                gödelian_issues.append(vote.witness_name)
        
        return {
            'claim': claim,
            'encoding': encoding.to_dict(),
            'votes': [v.to_dict() for v in votes],
            'consensus_score': consensus_score,
            'consensus_reached': consensus_reached,
            'spectral_value': spectral_value,
            'spectral_consensus': spectral_value >= 0.7,
            'gödelian_flagged_witnesses': gödelian_issues,
            'has_gödelian_issues': len(gödelian_issues) > 0,
            'chain_ready': consensus_reached and spectral_value >= 0.7 and len(gödelian_issues) == 0
        }
    
    def _witness_vote(self, claim: str, encoding: SPBLEncoding, 
                      witness: Dict) -> SpectralWitnessVote:
        """
        Generate a spectral vote from a single witness.
        """
        # Base agreement - influenced by domain bias
        domain_bias = witness['bias']
        
        # Agreement based on encoding fit with domain
        if witness['domain'] == WitnessDomain.PHYSICS:
            agreement_base = 0.7 + (encoding.coherence / 15.0) * 0.3
        elif witness['domain'] == WitnessDomain.PHILOSOPHY:
            agreement_base = 0.6 + (encoding.intensity / 15.0) * 0.4
        elif witness['domain'] == WitnessDomain.ETHICS:
            agreement_base = 0.5 + (encoding.position / 15.0) * 0.5
        elif witness['domain'] == WitnessDomain.HISTORY:
            agreement_base = 0.6 + (encoding.learning / 15.0) * 0.4
        elif witness['domain'] == WitnessDomain.SYSTEMS:
            agreement_base = 0.7 + (encoding.coherence / 15.0) * 0.3
        elif witness['domain'] == WitnessDomain.PHENOMENOLOGY:
            agreement_base = 0.5 + (encoding.intensity / 15.0) * 0.5
        else:  # W7 - Unwitnessed
            # Higher variance, lower predictability
            agreement_base = 0.5 + random.random() * 0.4
        
        # Add randomness for W7 (the unwitnessed)
        if witness['domain'] == WitnessDomain.UNWITNESSED:
            noise = (random.random() - 0.5) * 0.3
        else:
            noise = (random.random() - 0.5) * 0.1
        
        agreement = max(0, min(1, agreement_base + noise))
        
        # Compute intensity and coherence from encoding
        intensity = encoding.intensity / 15.0
        coherence = encoding.coherence / 15.0
        
        # Apply domain bias
        intensity = min(1, intensity + domain_bias.get('intensity', 0))
        coherence = min(1, coherence + domain_bias.get('coherence', 0))
        
        # Spectral confidence - how certain the witness is
        spectral_confidence = 0.5 + (agreement - 0.5) * 0.5
        
        # Check for Gödelian issues (self-reference or boundary claims)
        gödelian_flag = self._check_gödelian(claim)
        
        return SpectralWitnessVote(
            witness_name=witness['name'],
            domain=witness['domain'],
            agreement_score=agreement,
            intensity=intensity,
            coherence=coherence,
            spectral_confidence=spectral_confidence,
            gödelian_flag=gödelian_flag,
            reasoning=self._generate_reasoning(claim, witness, agreement)
        )
    
    def _compute_enhanced_spectral_value(self, votes: List[SpectralWitnessVote],
                                        encoding: SPBLEncoding) -> float:
        """Compute enhanced spectral value across all votes."""
        # Base spectral value from encoding
        base_spectral = encoding.spectral_value
        
        # Average witness spectral confidence
        avg_confidence = sum(v.spectral_confidence for v in votes) / len(votes)
        
        # Blended spectral value
        spectral = (base_spectral * 0.4 + avg_confidence * 0.6)
        
        # Penalize for Gödelian flags
        gödelian_count = sum(1 for v in votes if v.gödelian_flag)
        if gödelian_count > 0:
            spectral *= (1 - gödelian_count * 0.1)
        
        return min(1, max(0, spectral))
    
    def _check_gödelian(self, claim: str) -> bool:
        """Check if claim has Gödelian characteristics."""
        gödelian_patterns = [
            'this claim is true',
            'this proposition is false',
            'the system is complete',
            'all truths are encoded',
            'this chain contains everything',
            'the witnesses are infallible',
            'truth is absolute',
            'the system proves itself'
        ]
        return any(pattern in claim.lower() for pattern in gödelian_patterns)
    
    def _generate_reasoning(self, claim: str, witness: Dict, agreement: float) -> str:
        """Generate reasoning for witness vote."""
        if agreement > 0.8:
            return f"{witness['name']} strongly agrees: {claim[:50]}... aligns with {witness['domain'].value}"
        elif agreement > 0.6:
            return f"{witness['name']} moderately agrees: {claim[:50]}... mostly aligns with {witness['domain'].value}"
        elif agreement > 0.4:
            return f"{witness['name']} is neutral: {claim[:50]}... ambiguous in {witness['domain'].value}"
        else:
            return f"{witness['name']} disagrees: {claim[:50]}... conflicts with {witness['domain'].value}"

class GödelianBoundaryDetector:
    """
    Detects and flags Gödelian boundaries in claims and chain.
    """
    
    def __init__(self):
        self.unprovable_categories = {
            'self_reference': [
                'this claim', 'this statement', 'this proposition',
                'this system', 'this chain', 'this truth'
            ],
            'completeness': [
                'all truths', 'everything', 'complete', 'total',
                'all knowledge', 'absolute truth'
            ],
            'self_consistency': [
                'consistent', 'perfect', 'infallible', 'unquestionable',
                'beyond doubt', 'certain'
            ],
            'transcendence': [
                'outside the system', 'beyond the chain',
                'unwitnessed', 'unobservable', 'ineffable'
            ]
        }
    
    def check(self, claim: str, encoding: SPBLEncoding) -> Dict:
        """
        Check claim for Gödelian boundary violations.
        """
        issues = []
        claim_lower = claim.lower()
        
        for category, patterns in self.unprovable_categories.items():
            for pattern in patterns:
                if pattern in claim_lower:
                    issues.append({
                        'category': category,
                        'pattern': pattern,
                        'severity': self._get_severity(category)
                    })
        
        # Check intensity - claims at maximum often hit boundaries
        if encoding.intensity >= 14:
            issues.append({
                'category': 'max_intensity',
                'pattern': 'claim has maximum intensity',
                'severity': 'medium'
            })
        
        # Check coherence - perfect coherence is suspicious
        if encoding.coherence >= 14:
            issues.append({
                'category': 'max_coherence',
                'pattern': 'claim has maximum coherence',
                'severity': 'low'
            })
        
        return {
            'has_issues': len(issues) > 0,
            'issues': issues,
            'is_gödelian': self._is_gödelian_claim(claim),
            'boundary_type': self._identify_boundary_type(claim)
        }
    
    def _get_severity(self, category: str) -> str:
        """Get severity of boundary type."""
        severities = {
            'self_reference': 'high',
            'self_consistency': 'high',
            'completeness': 'critical',
            'transcendence': 'critical'
        }
        return severities.get(category, 'medium')
    
    def _is_gödelian_claim(self, claim: str) -> bool:
        """Check if claim is a Gödelian sentence."""
        patterns = [
            'cannot be proven',
            'is true but unprovable',
            'system cannot know',
            'outside the system'
        ]
        return any(p in claim.lower() for p in patterns)
    
    def _identify_boundary_type(self, claim: str) -> str:
        """Identify the type of boundary claim."""
        if any(p in claim.lower() for p in ['prove', 'proof', 'verification']):
            return 'verification_boundary'
        if any(p in claim.lower() for p in ['truth', 'reality', 'existence']):
            return 'ontological_boundary'
        if any(p in claim.lower() for p in ['should', 'must', 'right']):
            return 'ethical_boundary'
        if any(p in claim.lower() for p in ['consciousness', 'experience']):
            return 'phenomenological_boundary'
        return 'unknown_boundary'
