"""
SPBL - Synthetic Philosophical Binary Language Encoder for SCOS

Maps natural language claims to 4-bit encoded representations for
formal verification and spectral truth assessment.
"""

import hashlib
import re
from typing import Dict, List, Tuple, Optional
from dataclasses import dataclass
from enum import Enum

class SpectralDimension(Enum):
    """4-bit encoding dimensions for SPBL."""
    INTENSITY = 0    # How strongly held
    POSITION = 1     # Where in the argument space
    LEARNING = 2     # How much it challenges/teaches
    COHERENCE = 3    # How it fits with verified truths

@dataclass
class SPBLEncoding:
    """Complete SPBL encoding of a claim."""
    raw_claim: str
    intensity: int  # 0-15
    position: int   # 0-15
    learning: int   # 0-15
    coherence: int  # 0-15
    spectral_value: float  # 0-1
    hash: str
    
    def to_binary(self) -> str:
        """Convert to 16-bit binary string."""
        return f"{self.intensity:04b}{self.position:04b}{self.learning:04b}{self.coherence:04b}"
    
    def to_hex(self) -> str:
        """Convert to 4-character hex string."""
        return f"{self.intensity:X}{self.position:X}{self.learning:X}{self.coherence:X}"
    
    def to_dict(self) -> Dict:
        return {
            'raw_claim': self.raw_claim,
            'intensity': self.intensity,
            'position': self.position,
            'learning': self.learning,
            'coherence': self.coherence,
            'spectral_value': self.spectral_value,
            'binary': self.to_binary(),
            'hex': self.to_hex(),
            'hash': self.hash
        }

class SPBLEncoder:
    """
    Encodes natural language claims into SPBL format.
    
    Maps semantic features to 4-bit dimensions:
    - Intensity: Emotional/cognitive weight (0=trivial, 15=fundamental)
    - Position: Where in the argument space (0=agreement, 15=opposition)
    - Learning: How much it challenges existing truths (0=affirms, 15=transforms)
    - Coherence: Fit with verified chain (0=contradictory, 15=perfect fit)
    """
    
    def __init__(self, chain_context: Optional[List] = None):
        self.chain_context = chain_context or []
        self.truth_patterns = self._load_truth_patterns()
        
    def encode(self, claim: str, witness_votes: Optional[List[float]] = None) -> SPBLEncoding:
        """
        Encode a claim into SPBL format.
        
        Args:
            claim: Natural language claim
            witness_votes: Optional list of witness agreement scores (0-1)
            
        Returns:
            SPBLEncoding object
        """
        # Extract semantic features
        intensity = self._assess_intensity(claim)
        position = self._assess_position(claim)
        learning = self._assess_learning(claim)
        coherence = self._assess_coherence(claim)
        
        # If we have witness votes, use them to refine spectral value
        spectral_value = self._compute_spectral_value(
            intensity, position, learning, coherence,
            witness_votes
        )
        
        # Generate hash for verification
        hash_input = f"{claim}|{intensity}|{position}|{learning}|{coherence}"
        hash_value = hashlib.sha256(hash_input.encode()).hexdigest()[:16]
        
        return SPBLEncoding(
            raw_claim=claim,
            intensity=intensity,
            position=position,
            learning=learning,
            coherence=coherence,
            spectral_value=spectral_value,
            hash=hash_value
        )
    
    def _assess_intensity(self, claim: str) -> int:
        """Measure intensity (0-15)."""
        intensity_score = 0
        
        # Fundamental principles (high intensity)
        if any(term in claim.lower() for term in [
            'truth', 'reality', 'existence', 'consciousness',
            'golden rule', 'ego', 'witness'
        ]):
            intensity_score += 4
        
        # Ethical/moral claims
        if any(term in claim.lower() for term in [
            'should', 'must', 'right', 'wrong', 'good', 'evil'
        ]):
            intensity_score += 3
        
        # Strong qualifiers
        if any(term in claim.lower() for term in [
            'absolutely', 'certainly', 'undeniably', 'fundamentally'
        ]):
            intensity_score += 3
        
        # Length as proxy for complexity
        if len(claim.split()) > 10:
            intensity_score += 2
        
        # Reference to SCOS/Chain adds intensity
        if any(term in claim.lower() for term in ['scos', 'chain', 'witness']):
            intensity_score += 3
        
        return min(15, intensity_score)
    
    def _assess_position(self, claim: str) -> int:
        """Assess position in argument space (0-15)."""
        position_score = 8  # Neutral center
        
        # Opposition markers (towards 15)
        if any(term in claim.lower() for term in [
            'not', 'but', 'however', 'against', 'oppose', 'reject'
        ]):
            position_score += 3
        
        # Agreement markers (towards 0)
        if any(term in claim.lower() for term in [
            'yes', 'agree', 'confirm', 'validate', 'support'
        ]):
            position_score -= 3
        
        # Modifiers
        if 'partially' in claim.lower():
            position_score += 0  # Stay in middle
        elif 'strongly' in claim.lower():
            if position_score > 8:
                position_score += 2
            else:
                position_score -= 2
        
        return max(0, min(15, position_score))
    
    def _assess_learning(self, claim: str) -> int:
        """Assess learning/challenge value (0-15)."""
        learning_score = 5  # Moderate challenge
        
        # Revolutionary claims
        if any(term in claim.lower() for term in [
            'new', 'discover', 'reveal', 'transform', 'paradigm'
        ]):
            learning_score += 4
        
        # Questioning assumptions
        if '?' in claim or any(term in claim.lower() for term in [
            'question', 'challenge', 'rethink'
        ]):
            learning_score += 3
        
        # Affirming established truths
        if any(term in claim.lower() for term in [
            'confirm', 'verify', 'maintain', 'preserve'
        ]):
            learning_score -= 2
        
        # Self-referential learning
        if 'learn' in claim.lower():
            learning_score += 2
        
        return max(0, min(15, learning_score))
    
    def _assess_coherence(self, claim: str) -> int:
        """Assess coherence with verified chain (0-15)."""
        if not self.chain_context:
            return 8  # Neutral without context
        
        coherence_score = 8
        
        # Check against existing blocks in chain context
        for block in self.chain_context[-5:]:  # Check recent blocks
            block_text = str(block).lower()
            claim_words = set(claim.lower().split())
            block_words = set(block_text.split())
            
            # Overlap score
            overlap = len(claim_words & block_words) / max(len(claim_words), 1)
            if overlap > 0.3:
                coherence_score += 2
            elif overlap < 0.1:
                coherence_score -= 2
        
        # Check for contradictions with known patterns
        for pattern in self.truth_patterns:
            if pattern in claim.lower():
                coherence_score += 3  # Matches verified pattern
        
        return max(0, min(15, coherence_score))
    
    def _compute_spectral_value(self, intensity: int, position: int, 
                                learning: int, coherence: int,
                                witness_votes: Optional[List[float]]) -> float:
        """Compute spectral truth value (0-1)."""
        # Normalize dimensions to 0-1
        norm_intensity = intensity / 15.0
        norm_position = 1 - (abs(position - 7.5) / 7.5)  # Closeness to center
        norm_learning = learning / 15.0
        norm_coherence = coherence / 15.0
        
        # Base spectral value from encoding
        spectral_base = (norm_intensity * 0.3 + 
                        norm_position * 0.2 +
                        norm_learning * 0.2 +
                        norm_coherence * 0.3)
        
        # If witness votes available, blend them
        if witness_votes:
            avg_witness = sum(witness_votes) / len(witness_votes)
            spectral_base = (spectral_base * 0.4 + avg_witness * 0.6)
        
        return min(1.0, max(0.0, spectral_base))
    
    def _load_truth_patterns(self) -> List[str]:
        """Load verified truth patterns from SCOS philosophy."""
        return [
            "the ego is inferior to truth",
            "the possibility is the proof",
            "the golden rule is universal",
            "the unwitnessed deserve recognition",
            "consensus is physical",
            "truth is discovered not created"
        ]

class SPBLVerifier:
    """
    Verifies claims against SPBL encoding and chain consistency.
    """
    
    def __init__(self, chain_context: Optional[List] = None):
        self.encoder = SPBLEncoder(chain_context)
        self.gödelian_detector = GödelianBoundaryDetector()
    
    def verify_claim(self, claim: str, witness_votes: List[float]) -> Dict:
        """
        Complete verification of a claim.
        
        Returns:
            Dict with verification results
        """
        # Encode in SPBL
        encoding = self.encoder.encode(claim, witness_votes)
        
        # Check Gödelian boundaries
        boundary_check = self.gödelian_detector.check(claim, encoding)
        
        # Verify spectral truth
        spectral_verified = encoding.spectral_value >= 0.5
        
        # Check consistency with chain
        chain_consistent = self._check_chain_consistency(encoding)
        
        return {
            'claim': claim,
            'encoding': encoding.to_dict(),
            'spectral_verified': spectral_verified,
            'chain_consistent': chain_consistent,
            'gödelian_issues': boundary_check,
            'verification_passed': spectral_verified and chain_consistent and not boundary_check['has_issues'],
            'consensus_threshold_met': encoding.spectral_value >= 0.8
        }
    
    def _check_chain_consistency(self, encoding: SPBLEncoding) -> bool:
        """Check consistency with chain."""
        # Placeholder - would check against actual chain
        return encoding.coherence >= 5
