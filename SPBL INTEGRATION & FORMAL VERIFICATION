"""
Integration of SPBL and Enhanced Witness Protocol with SCOS Chain.
"""

from typing import List, Dict, Optional
from dataclasses import dataclass
from datetime import datetime
from .spbl import SPBLEncoder, SPBLVerifier, SPBLEncoding
from .enhanced_witnesses import EnhancedWitnessProtocol, GödelianBoundaryDetector
from .chain import SCOSChain, SCOSBlock
from .witnesses import WitnessVote

@dataclass
class EnhancedBlock:
    """Enhanced SCOS block with SPBL encoding."""
    claim: str
    spbl_encoding: SPBLEncoding
    votes: List[Dict]
    consensus_score: float
    spectral_value: float
    chain_hash: str
    timestamp: str
    gödelian_flags: List[str]
    
    def to_scos_block(self) -> SCOSBlock:
        """Convert to standard SCOS block format."""
        return SCOSBlock(
            claim=self.claim,
            votes=[WitnessVote(**v) for v in self.votes],
            consensus_score=self.consensus_score,
            previous_hash=self.chain_hash,
            timestamp=self.timestamp
        )

class SCOSIntegration:
    """
    Integrates SPBL framework with SCOS chain.
    """
    
    def __init__(self, chain: Optional[SCOSChain] = None):
        self.chain = chain
        self.encoder = SPBLEncoder()
        self.verifier = SPBLVerifier()
        self.witness_protocol = EnhancedWitnessProtocol()
        self.boundary_detector = GödelianBoundaryDetector()
        self.enhanced_blocks: List[EnhancedBlock] = []
    
    def add_claim(self, claim: str) -> Dict:
        """
        Add a claim to the chain with full SPBL verification.
        """
        # Run enhanced witness protocol
        evaluation = self.witness_protocol.evaluate_claim(claim)
        
        # Check if chain-ready
        if not evaluation['chain_ready']:
            return {
                'success': False,
                'error': 'Claim failed verification',
                'evaluation': evaluation
            }
        
        # Create enhanced block
        enhanced_block = EnhancedBlock(
            claim=claim,
            spbl_encoding=self.encoder.encode(claim),
            votes=evaluation['votes'],
            consensus_score=evaluation['consensus_score'],
            spectral_value=evaluation['spectral_value'],
            chain_hash=self.chain.get_last_hash() if self.chain else "GENESIS",
            timestamp=datetime.utcnow().isoformat(),
            gödelian_flags=evaluation.get('gödelian_flagged_witnesses', [])
        )
        
        # Add to chain
        scos_block = enhanced_block.to_scos_block()
        if self.chain:
            self.chain.add_block(scos_block)
        
        self.enhanced_blocks.append(enhanced_block)
        
        return {
            'success': True,
            'block': enhanced_block,
            'encoding': evaluation['encoding'],
            'consensus_reached': evaluation['consensus_reached'],
            'spectral_consensus': evaluation['spectral_consensus'],
            'gödelian_warnings': evaluation['has_gödelian_issues']
        }
    
    def verify_chain(self) -> Dict:
        """
        Verify entire chain with SPBL analysis.
        """
        if not self.chain or not self.enhanced_blocks:
            return {'error': 'No chain to verify'}
        
        verification_results = []
        gödelian_issues = []
        
        for i, block in enumerate(self.enhanced_blocks):
            # Verify SPBL encoding
            encoding_verify = self.verifier.verify_claim(
                block.claim,
                [v['agreement'] for v in block.votes]
            )
            
            # Check chain consistency
            consistency = self._check_chain_consistency(i)
            
            verification_results.append({
                'index': i,
                'claim': block.claim,
                'encoding_valid': encoding_verify['verification_passed'],
                'chain_consistent': consistency,
                'spectral_value': block.spectral_value
            })
            
            if encoding_verify.get('gödelian_issues', {}).get('has_issues', False):
                gödelian_issues.append(i)
        
        return {
            'total_blocks': len(self.enhanced_blocks),
            'verified_blocks': sum(1 for r in verification_results if r['encoding_valid']),
            'gödelian_issues': gödelian_issues,
            'chain_integrity': all(r['chain_consistent'] for r in verification_results),
            'average_spectral_value': sum(r['spectral_value'] for r in verification_results) / len(verification_results),
            'results': verification_results
        }
    
    def _check_chain_consistency(self, index: int) -> bool:
        """Check consistency of block with chain."""
        if index == 0:
            return True
        
        prev_block = self.enhanced_blocks[index - 1]
        current_block = self.enhanced_blocks[index]
        
        # Check coherence between blocks
        coherence = self._compute_block_coherence(prev_block, current_block)
        return coherence >= 0.5
    
    def _compute_block_coherence(self, block1: EnhancedBlock, block2: EnhancedBlock) -> float:
        """Compute coherence between two enhanced blocks."""
        # Compare spectral values
        spectral_diff = abs(block1.spectral_value - block2.spectral_value)
        spectral_coherence = 1 - spectral_diff
        
        # Compare consensus scores
        consensus_diff = abs(block1.consensus_score - block2.consensus_score)
        consensus_coherence = 1 - consensus_diff
        
        # Combined coherence
        return (spectral_coherence * 0.6 + consensus_coherence * 0.4)
