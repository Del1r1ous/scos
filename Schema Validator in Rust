//! Additional constraints for validation

use super::super::schema::concept::Concept;
use super::super::schema::constants::*;
use super::validator::ValidationError;
use super::super::ValidationResult;

/// Check that the concept has a valid tension signature
pub fn validate_tension_signature(concept: &Concept) -> ValidationResult<()> {
    // Tension signature should not be all zeros
    if concept.tension_signature == 0 {
        // This is allowed for identity concepts
        if concept.logical_operator != LogicalOperator::Identity {
            return Err(ValidationError::SegmentValidation(
                "Tension signature must be non-zero for non-identity operators".to_string(),
            ));
        }
    }

    Ok(())
}

/// Check that the concept is properly grounded for its stratum
pub fn validate_grounding(concept: &Concept, grounding_map: &[u32]) -> ValidationResult<()> {
    if concept.stratum == Stratum::C0 {
        // C₀ concepts are self-grounding
        return Ok(());
    }

    // Check if this concept's tension signature has a C₀ grounding
    let has_grounding = grounding_map
        .iter()
        .any(|g| (g & concept.tension_signature) != 0);

    if !has_grounding {
        return Err(ValidationError::NoGrounding);
    }

    Ok(())
}

/// Check that the concept's epistemic status is consistent
pub fn validate_epistemic_consistency(concept: &Concept) -> ValidationResult<()> {
    use EpistemicStatus::*;

    match (concept.epistemic_status, concept.fit_metric) {
        (PragmaticallyTrue, fit) if fit < 0.8 => {
            return Err(ValidationError::SegmentValidation(
                format!("PragmaticallyTrue requires fit >= 0.8, got {}", fit)
            ));
        }
        (Consensus, fit) if fit < 0.9 => {
            return Err(ValidationError::SegmentValidation(
                format!("Consensus requires fit >= 0.9, got {}", fit)
            ));
        }
        (Horizoned, _) if !concept.horizon_flag => {
            return Err(ValidationError::SegmentValidation(
                "Horizoned status requires horizon_flag = true".to_string(),
            ));
        }
        _ => {}
    }

    Ok(())
}
