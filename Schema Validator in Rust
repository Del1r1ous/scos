//! # Schema Validator for Universal Translation Protocol
//!
//! This crate provides validation for 128-bit binary schemas that encode
//! concepts according to PSST (Pragmatic Stratified Set Theory).
//!
//! ## Core Components
//!
//! - **Parser**: Converts binary strings into structured data
//! - **Validator**: Ensures constraints are satisfied across strata
//! - **Schema**: Defines the 128-bit structure and segments
//!
//! ## Example
//!
//! ```rust
//! use schema_validator::{parse_binary, validate, Concept};
//!
//! let binary = "0000000000000100 00000010 000000010010 110010100011010101101001 0000111100000000 00001001 000000000000000000000001 00010010 00000000 00000000";
//! let concept = parse_binary(binary)?;
//! validate(&concept)?;
//! ```

pub mod parser;
pub mod schema;
pub mod validator;
pub mod cli;

// Re-export core types
pub use parser::binary_parser::parse_binary;
pub use validator::validator::{validate, validate_with_context, ValidationError};
pub use schema::concept::{Concept, Stratum, LogicalOperator, EpistemicStatus, HorizonFlag};
pub use schema::cultural_modulator::CulturalModulator;

/// Alias for a 128-bit binary string with spaces between segments
pub type BinaryString = String;

/// Alias for a raw 128-bit vector
pub type Binary128 = [u8; 16];

/// Result type for validator operations
pub type ValidationResult<T> = Result<T, ValidationError>;

/// Maximum fit metric value
pub const MAX_FIT: f32 = 1.0;

/// Minimum fit metric threshold for validation
pub const FIT_THRESHOLD: f32 = 0.7;
