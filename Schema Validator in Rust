                let concept = parse_binary(&line);
                let context = ValidationContext::new().with_min_fit(threshold);

                let result = match concept {
                    Ok(c) => match validate_with_context(&c, &context) {
                        Ok(()) => format!("Line {}: ✅ VALID", line_num + 1),
                        Err(e) => format!("Line {}: ❌ INVALID - {}", line_num + 1, e),
                    },
                    Err(e) => format!("Line {}: ❌ PARSE ERROR - {}", line_num + 1, e),
                };

                results.push(result);
            }

            if let Some(output_path) = output {
                let mut file = File::create(output_path)?;
                for result in &results {
                    writeln!(file, "{}", result)?;
