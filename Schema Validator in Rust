//! Core validation logic

use super::super::schema::concept::Concept;
use super::super::schema::constants::*;
use super::super::ValidationResult;
use thiserror::Error;

#[derive(Debug, Error, Clone, PartialEq)]
pub enum ValidationError {
    #[error("Invalid binary length: expected {expected}, got {actual}")]
    InvalidLength { expected: usize, actual: usize },

    #[error("Invalid character in binary string")]
    InvalidCharacter,

    #[error("Invalid ontology header: {0}")]
    InvalidOntologyHeader(u8),

    #[error("Invalid stratum: {0}")]
    InvalidStratum(u8),

    #[error("Invalid logical operator: {0}")]
    InvalidLogicalOperator(u8),

    #[error("Invalid epistemic status: {0}")]
    InvalidEpistemicStatus(u8),

    #[error("Invalid cultural modulator: {0}")]
    InvalidCulturalModulator(u32),

    #[error("Concept has stratum {stratum} but operator is invalid for that stratum")]
    StratumMismatch { stratum: u8 },

    #[error("Fit metric {0:.3} below minimum threshold")]
    FitTooLow(f32),

    #[error("Temporal delta {0:.3} out of range [-1.0, 1.0]")]
    TemporalDeltaOutOfRange(f32),

    #[error("Horizon flag should be set for fit metric {0:.3}")]
    HorizonFlagRequired(f32),

    #[error("Reserved bits must be zero: {0}")]
    ReservedBitsNonZero(u32),

    #[error("Concept has no grounding in C₀")]
    NoGrounding,

    #[error("C₃ concept cannot be horizoned")]
    C3HorizonInvalid,

    #[error("Segment validation failed: {0}")]
    SegmentValidation(String),
}

/// Validate a concept against all constraints
pub fn validate(concept: &Concept) -> ValidationResult<()> {
    validate_with_context(concept, &ValidationContext::default())
}

/// Validate with additional context
pub fn validate_with_context(concept: &Concept, context: &ValidationContext) -> ValidationResult<()> {
    // Check fit metric
    if concept.fit_metric < context.min_fit_threshold {
        return Err(ValidationError::FitTooLow(concept.fit_metric));
    }

    // Check temporal delta
    if concept.temporal_delta < -1.0 || concept.temporal_delta > 1.0 {
        return Err(ValidationError::TemporalDeltaOutOfRange(
            concept.temporal_delta,
        ));
    }

    // Check reserved bits (must be zero)
    if concept.reserved != 0 {
        return Err(ValidationError::ReservedBitsNonZero(concept.reserved));
    }

    // Check stratum-operator compatibility
    if !concept.is_stratum_valid() {
        return Err(ValidationError::StratumMismatch {
            stratum: concept.stratum as u8,
        });
    }

    // Check horizon flag logic
    if concept.should_horizon_flag() && !concept.horizon_flag {
        return Err(ValidationError::HorizonFlagRequired(concept.fit_metric));
    }

    // C₃ concepts cannot be horizoned
    if concept.stratum == Stratum::C3 && concept.horizon_flag {
        return Err(ValidationError::C3HorizonInvalid);
    }

    // Check grounding (C₁+ must have some C₀ grounding)
    if concept.stratum >= Stratum::C1 && !context.allow_ungrounded {
        // In a full implementation, we'd check the knowledge graph here
        // For now, we'll assume grounding is verified elsewhere
    }

    Ok(())
}

/// Context for validation
#[derive(Debug, Clone)]
pub struct ValidationContext {
    pub min_fit_threshold: f32,
    pub allow_ungrounded: bool,
    pub strict_mode: bool,
}

impl Default for ValidationContext {
    fn default() -> Self {
        Self {
            min_fit_threshold: FIT_THRESHOLD,
            allow_ungrounded: false,
            strict_mode: true,
        }
    }
}

impl ValidationContext {
    pub fn new() -> Self {
        Self::default()
    }

    pub fn with_min_fit(mut self, threshold: f32) -> Self {
        self.min_fit_threshold = threshold.clamp(0.0, 1.0);
        self
    }

    pub fn with_allow_ungrounded(mut self, allow: bool) -> Self {
        self.allow_ungrounded = allow;
        self
    }

    pub fn with_strict_mode(mut self, strict: bool) -> Self {
        self.strict_mode = strict;
        self
    }
}
