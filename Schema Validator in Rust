//! Segment boundary validation

use super::super::schema::constants::*;
use thiserror::Error;

#[derive(Debug, Error, Clone, PartialEq)]
pub enum SegmentValidationError {
    #[error("Segment {name} has invalid bits: {bits}")]
    InvalidBits { name: String, bits: u64 },
    #[error("Segment {name} out of range: {value}")]
    OutOfRange { name: String, value: u64 },
    #[error("Stratum {stratum} incompatible with operator {operator}")]
    StratumOperatorMismatch { stratum: u8, operator: u8 },
}

/// Validate all segment boundaries in the raw bytes
pub fn validate_segment(bytes: &[u8; SCHEMA_BYTES]) -> Result<(), SegmentValidationError> {
    // Validate ontology header (4 bits)
    let ontology = get_bits(bytes, segments::ONTOLOGY_HEADER.start, segments::ONTOLOGY_HEADER.end);
    if ontology > 0b1111 {
        return Err(SegmentValidationError::InvalidBits {
            name: "ontology_header".to_string(),
            bits: ontology,
        });
    }
    if ontology >= 0b1011 {
        // Reserved values
        return Err(SegmentValidationError::OutOfRange {
            name: "ontology_header".to_string(),
            value: ontology,
        });
    }

    // Validate stratum (2 bits)
    let stratum = get_bits(bytes, segments::STRATUM.start, segments::STRATUM.end);
    if stratum > 0b11 {
        return Err(SegmentValidationError::InvalidBits {
            name: "stratum".to_string(),
            bits: stratum,
        });
    }

    // Validate logical operator (4 bits)
    let operator = get_bits(bytes, segments::LOGICAL_OPERATOR.start, segments::LOGICAL_OPERATOR.end);
    if operator > 0b1111 {
        return Err(SegmentValidationError::InvalidBits {
            name: "logical_operator".to_string(),
            bits: operator,
        });
    }
    if operator >= 0b1101 {
        // Reserved values
        return Err(SegmentValidationError::OutOfRange {
            name: "logical_operator".to_string(),
            value: operator,
        });
    }

    // Validate tension signature (20 bits) - all values valid

    // Validate fit metric (12 bits) - all values valid

    // Validate epistemic status (4 bits)
    let status = get_bits(bytes, segments::EPISTEMIC_STATUS.start, segments::EPISTEMIC_STATUS.end);
    if status > 0b1111 {
        return Err(SegmentValidationError::InvalidBits {
            name: "epistemic_status".to_string(),
            bits: status,
        });
    }
    if status >= 0b1011 {
        // Reserved values
        return Err(SegmentValidationError::OutOfRange {
            name: "epistemic_status".to_string(),
            value: status,
        });
    }

    // Validate cultural modulator (24 bits) - all values valid

    // Validate temporal delta (16 bits) - all values valid

    // Validate horizon flag (1 bit)
    let horizon = get_bits(bytes, segments::HORIZON_FLAG.start, segments::HORIZON_FLAG.end);
    if horizon > 1 {
        return Err(SegmentValidationError::InvalidBits {
            name: "horizon_flag".to_string(),
            bits: horizon,
        });
    }

    // Validate reserved (41 bits) - all values valid

    // Validate stratum-operator compatibility
    let stratum_bits = stratum as u8;
    let operator_bits = operator as u8;

    // C₀ can only use basic operators
    if stratum_bits == 0 {
        // Stratum::C0
        if !matches!(operator_bits, 0b0000 | 0b0001 | 0b0110) {
            return Err(SegmentValidationError::StratumOperatorMismatch {
                stratum: stratum_bits,
                operator: operator_bits,
            });
        }
    }

    // C₁ can use C₀ + some C₁ operators
    if stratum_bits == 1 {
        if !matches!(
            operator_bits,
            0b0000 | 0b0001 | 0b0011 | 0b0100 | 0b0101 | 0b0110
        ) {
            return Err(SegmentValidationError::StratumOperatorMismatch {
                stratum: stratum_bits,
                operator: operator_bits,
            });
        }
    }

    // C₂ cannot use C₃ operators
    if stratum_bits == 2 {
        if matches!(
            operator_bits,
            0b0111 | 0b1000 | 0b1001 | 0b1010 | 0b1011 | 0b1100
        ) {
            return Err(SegmentValidationError::StratumOperatorMismatch {
                stratum: stratum_bits,
                operator: operator_bits,
            });
        }
    }

    // C₃ can use all operators

    Ok(())
}

/// Helper: Extract bits from bytes
fn get_bits(bytes: &[u8; SCHEMA_BYTES], start: usize, end: usize) -> u64 {
    let mut result = 0u64;
    let total_bits = end - start;

    for i in 0..total_bits {
        let bit_pos = start + i;
        let byte_idx = bit_pos / 8;
        let bit_offset = 7 - (bit_pos % 8);
        let bit = (bytes[byte_idx] >> bit_offset) & 1;
        result = (result << 1) | (bit as u64);
    }

    result
}
