pub mod commands;

use crate::parser::binary_parser::parse_binary;
use crate::validator::validator::{validate_with_context, ValidationContext};
use crate::CLI;
use clap::Parser;
use colored::*;
use std::fs::File;
use std::io::{BufRead, BufReader, Write};

pub fn run() -> Result<(), Box<dyn std::error::Error>> {
    let cli = CLI::parse();

    match cli.command {
        commands::Commands::Parse { binary, format } => {
            let concept = parse_binary(&binary)?;

            match format.as_str() {
                "json" => println!("{}", serde_json::to_string_pretty(&concept)?),
                "yaml" => println!("{}", serde_yaml::to_string(&concept)?),
                _ => {
                    println!("{}", "✅ Concept parsed successfully!".green());
                    println!("{}", "=".repeat(60).yellow());
                    println!("{}", concept.summary().cyan());
                    println!("{}", "=".repeat(60).yellow());
                    println!("{}", serde_json::to_string_pretty(&concept)?);
                }
            }
        }

        commands::Commands::Validate { binary, threshold, strict } => {
            let concept = parse_binary(&binary)?;
            let context = ValidationContext::new()
                .with_min_fit(threshold)
                .with_strict_mode(strict);

            match validate_with_context(&concept, &context) {
                Ok(()) => {
                    println!("{}", "✅ Validation PASSED".green());
                    println!("Fit: {:.3} / {:.3}", concept.fit_metric, threshold);
                    println!("Status: {}", concept.epistemic_status);
                    println!("Horizon: {}", if concept.horizon_flag { "🚩 FLAGGED" } else { "✓ OK" });
                }
                Err(e) => {
                    println!("{}", "❌ Validation FAILED".red());
                    println!("Error: {}", e);
                    std::process::exit(1);
                }
            }
        }

        commands::Commands::ValidateFile { file, threshold, output } => {
            let reader = BufReader::new(File::open(file)?);
            let mut results = Vec::new();

            for (line_num, line) in reader.lines().enumerate() {
                let line = line?;
                if line.trim().is_empty() {
                    continue;
