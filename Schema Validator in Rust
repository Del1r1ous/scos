//! Core concept representation

use super::constants::*;
use super::cultural_modulator::CulturalModulator;
use serde::{Deserialize, Serialize};
use std::fmt;

/// Complete 128-bit concept with parsed fields
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
pub struct Concept {
    /// Raw 128-bit encoding as 16 bytes
    pub raw: [u8; 16],

    /// Parsed fields
    pub ontology_header: OntologyHeader,
    pub stratum: Stratum,
    pub logical_operator: LogicalOperator,
    pub tension_signature: u32, // 20 bits
    pub fit_metric: f32,        // 0.0 - 1.0
    pub epistemic_status: EpistemicStatus,
    pub cultural_modulator: CulturalModulator,
    pub temporal_delta: f32, // -1.0 to 1.0
    pub horizon_flag: bool,
    pub reserved: u32, // 41 bits
}

impl Concept {
    /// Create a new concept from raw binary
    pub fn new(
        ontology_header: OntologyHeader,
        stratum: Stratum,
        logical_operator: LogicalOperator,
        tension_signature: u32,
        fit_metric: f32,
        epistemic_status: EpistemicStatus,
        cultural_modulator: CulturalModulator,
        temporal_delta: f32,
        horizon_flag: bool,
        reserved: u32,
    ) -> Self {
        // Validate fit_metric
        let fit_metric = fit_metric.clamp(0.0, 1.0);

        // Validate temporal_delta
        let temporal_delta = temporal_delta.clamp(-1.0, 1.0);

        let mut raw = [0u8; 16];

        // Encode all fields into raw binary
        // This would be complex - for now, we'll use a builder pattern
        // or derive from fields

        Self {
            raw,
            ontology_header,
            stratum,
            logical_operator,
            tension_signature: tension_signature & 0xFFFFF, // 20 bits
            fit_metric,
            epistemic_status,
            cultural_modulator,
            temporal_delta,
            horizon_flag,
            reserved: reserved & 0x1FFFFFFFFFF, // 41 bits
        }
    }

    /// Get the fit metric as a 12-bit encoded value
    pub fn fit_metric_encoded(&self) -> u16 {
        (self.fit_metric * 4095.0) as u16 // 12 bits
    }

    /// Get the temporal delta as a 16-bit encoded value
    pub fn temporal_delta_encoded(&self) -> u16 {
        ((self.temporal_delta + 1.0) / 2.0 * 65535.0) as u16 // 16 bits
    }

    /// Check if this concept is valid for its stratum
    pub fn is_stratum_valid(&self) -> bool {
        // C₀ concepts cannot use C₁, C₂, or C₃ operators
        if self.stratum == Stratum::C0 {
            return matches!(
                self.logical_operator,
                LogicalOperator::Identity
                    | LogicalOperator::Ground
                    | LogicalOperator::Contain
            );
        }

        // C₁ concepts can use C₀ operators plus some C₁ operators
        if self.stratum == Stratum::C1 {
            return matches!(
                self.logical_operator,
                LogicalOperator::Identity
                    | LogicalOperator::Ground
                    | LogicalOperator::Contain
                    | LogicalOperator::Reduce
                    | LogicalOperator::Cause
                    | LogicalOperator::Transform
            );
        }

        // C₂ concepts can use all operators except C₃ operators
        if self.stratum == Stratum::C2 {
            return !matches!(
                self.logical_operator,
                LogicalOperator::Calibrate
                    | LogicalOperator::And
                    | LogicalOperator::Or
                    | LogicalOperator::Not
                    | LogicalOperator::Implies
                    | LogicalOperator::Equiv
            );
        }

        // C₃ concepts can use all operators
        true
    }

    /// Check if horizon flag should be set based on fit metric
    pub fn should_horizon_flag(&self) -> bool {
        self.fit_metric < FIT_THRESHOLD || self.horizon_flag
    }

    /// Generate a human-readable summary
    pub fn summary(&self) -> String {
        format!(
            "Concept [{}] @ {} | Fit: {:.3} | Status: {} | Horizon: {}",
            self.ontology_header,
            self.stratum,
            self.fit_metric,
            self.epistemic_status,
            if self.horizon_flag { "🚩" } else { "✓" }
        )
    }
}

impl fmt::Display for Concept {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(
            f,
            "{}",
            serde_json::to_string_pretty(self).map_err(|_| fmt::Error)?
        )
    }
