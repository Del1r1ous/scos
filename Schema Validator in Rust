//! Cultural modulator encoding/decoding

use serde::{Deserialize, Serialize};
use std::fmt;

/// 24-bit cultural modulator
#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct CulturalModulator {
    /// Language family (6 bits)
    pub language_family: LanguageFamily,
    /// Region (6 bits)
    pub region: Region,
    /// Context (6 bits)
    pub context: Context,
    /// Dialect/Register (6 bits)
    pub dialect: Dialect,
}

impl CulturalModulator {
    /// Create from 24-bit value
    pub fn from_u24(value: u32) -> Option<Self> {
        if value > 0xFFFFFF {
            return None;
        }

        let language_family = LanguageFamily::from_u6((value >> 18) as u8);
        let region = Region::from_u6(((value >> 12) & 0x3F) as u8);
        let context = Context::from_u6(((value >> 6) & 0x3F) as u8);
        let dialect = Dialect::from_u6((value & 0x3F) as u8);

        Some(Self {
            language_family: language_family?,
            region: region?,
            context: context?,
            dialect: dialect?,
        })
    }

    /// Encode to 24-bit integer
    pub fn to_u24(&self) -> u32 {
        ((self.language_family as u32) << 18)
            | ((self.region as u32) << 12)
            | ((self.context as u32) << 6)
            | (self.dialect as u32)
    }

    /// Serialize to binary string (24 bits with spaces every 6 bits)
    pub fn to_binary_string(&self) -> String {
        let value = self.to_u24();
        format!(
            "{:06b} {:06b} {:06b} {:06b}",
            (value >> 18) & 0x3F,
            (value >> 12) & 0x3F,
            (value >> 6) & 0x3F,
            value & 0x3F
        )
    }
}

impl fmt::Display for CulturalModulator {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(
            f,
            "{{language_family: {}, region: {}, context: {}, dialect: {}}}",
            self.language_family, self.region, self.context, self.dialect
        )
    }
}

