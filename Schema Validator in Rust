                let ontology_header = OntologyHeader::from_u4(rng.gen_range(0..=10)).unwrap_or(OntologyHeader::Physical);
                let actual_stratum = match stratum {
                    Some(s) => match s {
                        0 => Stratum::C0,
                        1 => Stratum::C1,
                        2 => Stratum::C2,
                        3 => Stratum::C3,
                        _ => Stratum::C0,
                    },
                    None => match rng.gen_range(0..=3) {
                        0 => Stratum::C0,
                        1 => Stratum::C1,
                        2 => Stratum::C2,
                        _ => Stratum::C3,
                    },
                };

                let logical_operator = LogicalOperator::from_u4(rng.gen_range(0..=12)).unwrap_or(LogicalOperator::Identity);
                let tension_signature = rng.gen_range(0..=0xFFFFF);
                let fit_metric = rng.gen_range(0.7..=1.0);
                let epistemic_status = EpistemicStatus::from_u4(rng.gen_range(0..=10)).unwrap_or(EpistemicStatus::Unvalidated);

                let cultural_modulator = CulturalModulator::from_u24(rng.gen_range(0..=0xFFFFFF)).unwrap();
                let temporal_delta = rng.gen_range(-1.0..=1.0);
                let horizon_flag = fit_metric < 0.7;

                let concept = Concept::new(
                    ontology_header,
                    actual_stratum,
                    logical_operator,
                    tension_signature,
                    fit_metric,
                    epistemic_status,
                    cultural_modulator,
                    temporal_delta,
                    horizon_flag,
                    0,
                );

                if format == "json" {
                    println!("{}", serde_json::to_string(&concept)?);
                } else {
                    println!("Generated Concept #{}:", i + 1);
                    println!("{}", "=".repeat(40).yellow());
                    println!("{}", concept.summary().cyan());
                    println!("Culture: {}", concept.cultural_modulator);
                    println!("Tension: 0x{:05X}", concept.tension_signature);
                    println!("Temporal: {:.3}", concept.temporal_delta);
                    println!();
                }
            }
        }

        commands::Commands::Info { detailed } => {
            println!("{}", "📋 Universal Translation Protocol - Schema Information".cyan());
            println!("{}", "=".repeat(60).yellow());
            println!("Total bits: {}", 128);
            println!("Total bytes: {}", 16);

            if detailed {
                println!();
                println!("{}", "📊 Segment Layout".green());
                println!("{:<20} {:<10} {:<10} {}", "Segment", "Start", "End", "Bits");
                println!("{}", "-".repeat(50).dimmed());

                let segments = [
                    ("Ontology Header", 0, 4),
                    ("Stratum", 4, 6),
                    ("Logical Operator", 6, 10),
                    ("Tension Signature", 10, 30),
                    ("Fit Metric", 30, 42),
                    ("Epistemic Status", 42, 46),
                    ("Cultural Modulator", 46, 70),
                    ("Temporal Delta", 70, 86),
                    ("Horizon Flag", 86, 87),
                    ("Reserved", 87, 128),
                ];

                for (name, start, end) in segments {
                    println!(
                        "{:<20} {:<10} {:<10} {}",
                        name,
                        start,
                        end,
                        end - start
                    );
                }
            }
        }

        commands::Commands::Benchmark { iterations } => {
            use std::time::Instant;
            use rand::Rng;

            println!("Running benchmark with {} iterations...", iterations);
            let start = Instant::now();

            let mut successes = 0;
            let mut errors = 0;

            for _ in 0..iterations {
                let mut rng = rand::thread_rng();

                // Generate random valid concept
                let ontology = OntologyHeader::from_u4(rng.gen_range(0..=10)).unwrap();
                let stratum = match rng.gen_range(0..=3) {
                    0 => Stratum::C0,
                    1 => Stratum::C1,
                    2 => Stratum::C2,
                    _ => Stratum::C3,
                };
                let op = LogicalOperator::from_u4(rng.gen_range(0..=12)).unwrap();
                let tension = rng.gen_range(0..=0xFFFFF);
                let fit = rng.gen_range(0.0..=1.0);
                let status = EpistemicStatus::from_u4(rng.gen_range(0..=10)).unwrap();
                let cultural = CulturalModulator::from_u24(rng.gen_range(0..=0xFFFFFF)).unwrap();
                let temporal = rng.gen_range(-1.0..=1.0);
                let horizon = fit < 0.7;

                let concept = Concept::new(
                    ontology,
                    stratum,
                    op,
                    tension,
                    fit,
                    status,
                    cultural,
                    temporal,
                    horizon,
                    0,
                );

                // Validate
                match validate_with_context(&concept, &ValidationContext::default()) {
                    Ok(()) => successes += 1,
                    Err(_) => errors += 1,
                }
            }

            let duration = start.elapsed();
            println!();
            println!("📊 Benchmark Results:");
            println!("Iterations: {}", iterations);
            println!("Successes: {}", successes);
            println!("Errors: {}", errors);
            println!("Time: {:?}", duration);
            println!("Throughput: {:.0} concepts/sec", iterations as f64 / duration.as_secs_f64());
        }
    }

    Ok(())
}
